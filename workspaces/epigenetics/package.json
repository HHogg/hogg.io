{
  "name": "@hogg/epigenetics",
  "version": "0.0.0",
  "author": "Harry Hogg <harry@hogg.io>",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "yarn build:types && yarn build:wasm",
    "build:types": "typeshare --lang=typescript --output-file=./src/worker/types.generated.ts .",
    "build:wasm": "wasm-pack build --target web --out-dir pkg/hogg_epigenetics_worker --no-opt",
    "clean": "rm -rf ./pkg && rm -rf ./src/worker/types.ts",
    "dev": "yarn build:wasm && yarn dev:watch",
    "dev:watch": "node ../../scripts/watch-build.mjs",
    "lint:rust": "cargo clippy --lib -p hogg_epigenetics",
    "test:rust": "cargo test --lib -p hogg_epigenetics --target $(rustc -vV | grep '^host:' | cut -d' ' -f2)"
  },
  "dependencies": {
    "@hogg/common": "workspace:^",
    "comlink": "^4.4.1",
    "lucide-react": "0.445.0",
    "preshape": "^19.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "typescript": "^5.0.4"
  }
}
