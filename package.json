{
  "name": "hogg.io",
  "version": "0.0.0",
  "author": "Harry Hogg <harry@hogg.io>",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@3.5.1",
  "type": "module",
  "workspaces": [
    "./workspaces/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -ptvR --from @hogg/website run build",
    "ci:check": "CI=true yarn format:check && yarn ts:check && yarn lint && yarn test:ci && yarn build",
    "deploy": "firebase deploy",
    "dev": "yarn workspaces foreach -pviR --from @hogg/website -j unlimited run dev",
    "format": "yarn format:prettier && yarn format:rust",
    "format:check": "yarn format:prettier:check && yarn format:rust:check",
    "format:prettier": "prettier --write .",
    "format:prettier:check": "prettier --check .",
    "format:rust": "cargo fmt --all",
    "format:rust:check": "cargo fmt --all -- --check",
    "lint": "yarn lint:css && yarn lint:js && yarn lint:rust",
    "lint:css": "stylelint workspaces/**/*.css",
    "lint:js": "yarn tsc && yarn knip && eslint 'workspaces/**/*.tsx' 'workspaces/**/*.ts' --fix",
    "lint:rust": "yarn workspaces foreach -tv --interlaced run lint:rust",
    "preview": "yarn workspace @hogg/website preview",
    "test:ci": "yarn test:js:ci && yarn test:rust:ci",
    "test:js:ci": "vitest run",
    "test:rust:ci": "yarn workspaces foreach -tv --interlaced --exclude 'hogg.io' run test:rust",
    "test:rust:clean": "cargo insta test --unreferenced=delete",
    "test:rust:review": "cargo insta review --include-ignored",
    "ts:check": "tsc --noEmit --skipLibCheck",
    "update:preshape": "yarn workspaces foreach -tvR --from @hogg/website add preshape"
  },
  "devDependencies": {
    "@types/node": "^20.11.20",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitest/ui": "^3.2.4",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "firebase-tools": "^13.3.0",
    "knip": "^5.0.1",
    "prettier": "^2.8.8",
    "stylelint": "^15.6.1",
    "stylelint-config-standard": "^33.0.0",
    "typescript": "^5.0.4",
    "vite": "^5.2.9",
    "vitest": "^3.2.4"
  }
}
